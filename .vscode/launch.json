{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug bun test (UI file)",
      "runtime": "bun",
      "runtimeArgs": ["test"],
      "program": "${file}",
      "cwd": "${workspaceFolder}/packages/ui",
      "watchMode": false,
      "stopOnEntry": false
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug bun test (common file)",
      "runtime": "bun",
      "runtimeArgs": ["test"],
      "program": "${file}",
      "cwd": "${workspaceFolder}/packages/common",
      "watchMode": false,
      "stopOnEntry": false
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug UI (Chrome)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/packages/ui/src",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Figma Plugin (Developer VM)",
      "port": 9222,
      "urlFilter": "*figma*",
      "skipFiles": ["<node_internals>/**"],
      "pathMapping": {
        "/": "${workspaceFolder}/apps/figma-plugin/src/"
      }
    }
  ]
}
