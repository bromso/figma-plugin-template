{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug bun test (current file)",
      "command": "bun test --inspect-brk ${relativeFile}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug UI (Chrome)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/packages/ui/src",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Figma Plugin (Developer VM)",
      "port": 9222,
      "urlFilter": "*figma*",
      "skipFiles": ["<node_internals>/**"],
      "pathMapping": {
        "/": "${workspaceFolder}/apps/figma-plugin/src/"
      }
    }
  ]
}
